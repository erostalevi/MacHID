    "While it is on, MacHID watches key presses and extra mouse buttons to apply your rules. It never records or stores what you type.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras está activado, MacHID observa las teclas y los botones extra del mouse para aplicar tus reglas. Nunca registra ni guarda lo que escribes."
          }
        }
      }
    },
