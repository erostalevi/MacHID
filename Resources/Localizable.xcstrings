            "value": "Compartir un plugin"
          }
        }
      }
    },
    "A plugin is a small public repository that describes a device for MacHID's built-in drivers. Anyone can submit one with a pull request to the registry. It never runs code.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un plugin es un pequeño repositorio público que describe un dispositivo para los controladores incluidos en MacHID. Cualquiera puede proponer uno con un pull request al registro. Nunca ejecuta código."
          }
        }
      }
    },
