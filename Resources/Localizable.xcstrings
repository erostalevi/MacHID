            "value": "Luces"
          }
        }
      }
    },
    "Set the lighting of every connected device from here. Animations share one cycle time so they stay in step.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura la iluminación de todos los dispositivos conectados desde aquí. Las animaciones comparten un mismo tiempo de ciclo para mantenerse sincronizadas."
          }
        }
      }
    },
