    "Cycle time": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo de ciclo"
          }
        }
      }
    },
    "Keep devices in sync": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener dispositivos sincronizados"
          }
        }
      }
    },
    "Keyboards are drawn by MacHID from one shared clock, so they start every cycle together. Needs MacHID running.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MacHID dibuja los teclados desde un reloj compartido, así todos inician cada ciclo a la vez. Requiere MacHID en ejecución."
          }
        }
      }
    },
    "Apply to all devices": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar a todos los dispositivos"
          }
        }
      }
    },
    "Use per-device lighting": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar iluminación por dispositivo"
          }
        }
      }
    },
    "Some devices run the effect in their own firmware; they use the same cycle time but can drift apart.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos dispositivos ejecutan el efecto en su propio firmware; usan el mismo tiempo de ciclo pero pueden desfasarse."
          }
        }
      }
    }
