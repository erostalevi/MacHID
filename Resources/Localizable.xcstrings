    "A macro is a sequence of keys, clicks and pauses, and can also open things or run shell commands. Anything beyond keys and clicks needs your approval first.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una macro es una secuencia de teclas, clics y pausas, y también puede abrir cosas o ejecutar comandos de shell. Todo lo que vaya más allá de teclas y clics necesita tu aprobación."
          }
        }
      }
    },
