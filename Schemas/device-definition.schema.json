{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MacHID device definition",
  "type": "object",
  "required": ["id", "name", "category", "usb_ids", "driver", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$" },
    "name": { "type": "string", "minLength": 1 },
    "category": { "enum": ["mouse", "keyboard", "camera", "headset", "other"] },
    "usb_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9a-f]{4}:[0-9a-f]{4}$" } },
    "driver": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "access"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["dpi", "polling_rate", "lighting_zone", "brightness", "button_remap", "key_remap", "macro_slots", "profile_slots", "battery", "info", "camera_control", "device_mode"] },
          "access": { "enum": ["read", "write_volatile", "write_persistent"] },
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min": { "type": "integer" }, "max": { "type": "integer" }, "step": { "type": "integer", "minimum": 1 },
              "values": { "type": "array", "items": { "type": "integer" } },
              "slots": { "type": "integer", "minimum": 1 },
              "zones": {
                "type": "array",
                "items": {
                  "type": "object", "required": ["id", "modes"], "additionalProperties": false,
                  "properties": { "id": { "type": "string" }, "modes": { "type": "array", "items": { "type": "string" } } }
                }
              }
            }
          }
        }
      }
    }
  }
}
