{
  "id": "razer-huntsman-mini",
  "name": "Razer Huntsman Mini",
  "category": "keyboard",
  "usb_ids": [
    "1532:0257"
  ],
  "driver": "razer",
  "capabilities": [
    {
      "id": "info",
      "type": "info",
      "access": "read"
    },
    {
      "id": "brightness",
      "type": "brightness",
      "access": "write_volatile",
      "parameters": {
        "min": 0,
        "max": 100,
        "step": 1
      }
    },
    {
      "id": "device_mode",
      "type": "device_mode",
      "access": "write_volatile",
      "parameters": {
        "values": [
          0,
          3
        ]
      }
    },
    {
      "id": "backlight",
      "type": "lighting_zone",
      "access": "write_volatile",
      "parameters": {
        "zones": [
          {
            "id": "backlight",
            "modes": [
              "static",
              "off",
              "spectrum",
              "wave",
              "reactive",
              "starlight",
              "breathing"
            ],
            "mode_options": {
              "wave": {
                "directions": [
                  "left_to_right",
                  "right_to_left"
                ]
              },
              "reactive": {
                "speed_min": 1,
                "speed_max": 4,
                "colors_min": 1,
                "colors_max": 1
              },
              "starlight": {
                "speed_min": 1,
                "speed_max": 3,
                "colors_min": 0,
                "colors_max": 2
              },
              "breathing": {
                "colors_min": 0,
                "colors_max": 2
              }
            }
          }
        ]
      }
    },
    {
      "id": "key_lighting",
      "type": "per_key_lighting",
      "access": "write_volatile",
      "parameters": {
        "rows": 5,
        "columns": 15
      }
    }
  ],
  "driver_options": {
    "lighting_transaction_id": "0x3F"
  },
  "artwork": "artwork/huntsman-mini.svg"
}
